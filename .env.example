# URL /exec del despliegue Web App del MISMO Apps Script que usa el SGA actual.
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/REEMPLAZAR/exec

# Debe coincidir con Script Properties > SGA_NEXT_API_KEY.
# Nunca usar NEXT_PUBLIC_ para este valor.
APPS_SCRIPT_API_KEY=REEMPLAZAR_CON_SECRETO_LARGO
